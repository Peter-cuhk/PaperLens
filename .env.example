# Server-side only. Never expose API keys through NEXT_PUBLIC_* variables.
# CloudBase Hunyuan (recommended for the deployed service).
CLOUDBASE_ENV_ID=
CLOUDBASE_APIKEY=
PAPERLENS_HUNYUAN_PROVIDER=hunyuan-v3
PAPERLENS_HUNYUAN_TRANSLATION_MODEL=hy3
PAPERLENS_HUNYUAN_CHAT_MODEL=hy3

OPENAI_API_KEY=
# Optional OpenAI-compatible gateway (Sub2API: https://sub2api.cocomatrix.cn/v1).
PAPERLENS_OPENAI_BASE_URL=
# Set to 1 for gateways that require streaming Responses API output.
PAPERLENS_OPENAI_STREAM=0
PAPERLENS_OPENAI_TRANSLATION_MODEL=gpt-5.6-terra
PAPERLENS_OPENAI_CHAT_MODEL=gpt-5.6-terra
PAPERLENS_OPENAI_REASONING_EFFORT=low

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
PAPERLENS_MIMO_TRANSLATION_MODEL=mimo-v2.5
PAPERLENS_MIMO_CHAT_MODEL=mimo-v2.5

# 实验性 ChatGPT 网页问答（需要加载 browser-extension/）
PAPERLENS_CHATGPT_WEB_ENABLED=1
PAPERLENS_CHATGPT_WEB_PORT=43124
PAPERLENS_CHATGPT_WEB_TIMEOUT_MS=240000

# Optional: override LibreOffice's `soffice` path for local Word/PPT to PDF conversion.
# Windows: prefer C:\Program Files\LibreOffice\program\soffice.com (soffice.exe is also supported).
# Use the full path; spaces/Chinese characters are supported. Restart the bridge after changes.
# A configured missing path does not fall back to another installation.
PAPERLENS_SOFFICE_PATH=
