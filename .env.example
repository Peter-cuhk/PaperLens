# Optional: override the Codex CLI executable discovered from PATH.
PAPERLENS_CODEX_PATH=

# ChatGPT Web Chat handles chat, translation, and terminology tasks.
PAPERLENS_CHATGPT_WEB_ENABLED=1
PAPERLENS_CHATGPT_WEB_PORT=43124
PAPERLENS_CHATGPT_WEB_TIMEOUT_MS=240000

# Preferred distribution. Fill this after publishing the packaged ZIP to the
# Chrome Web Store; PaperLens then shows the store installation button.
PAPERLENS_EXTENSION_STORE_URL=

# Optional: override LibreOffice's `soffice` path for local Word/PPT to PDF conversion.
PAPERLENS_SOFFICE_PATH=
