{
  "name": "paperlens-local",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "bridge": "node bridge/server.mjs",
    "chatgpt-web:setup": "./scripts/open-chatgpt-web-setup.sh",
    "build": "node scripts/vinext.mjs build",
    "start": "node scripts/vinext.mjs start",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:startup-smoke": "node --test tests/startup-smoke.test.mjs",
    "test:office": "node --test tests/document-converter.test.mjs tests/document-converter-bridge.test.mjs",
    "test:office-smoke": "node --test tests/office-conversion.smoke.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@cloudbase/node-sdk": "^3.18.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.1",
    "next": "^16.2.12",
    "openai": "^7.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
